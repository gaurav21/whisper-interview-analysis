{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "whisper-analysis",
	"main": "src/workers/analysis.ts",
	"compatibility_flags": ["nodejs_compat"],
	"compatibility_date": "2025-12-25",
	"observability": {
		"enabled": true
	},
	
	// R2 bucket for audio files and transcripts
	"r2_buckets": [
		{
			"binding": "AUDIO_BUCKET",
			"bucket_name": "whisper-audio-files",
			"preview_bucket_name": "whisper-audio-files-preview"
		}
	],
	
	// D1 database for structured data
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "whisper-db",
			"database_id": "8b0870f8-d275-470d-ac98-c6d5e7982f29",
			"preview_database_id": "8b0870f8-d275-470d-ac98-c6d5e7982f29"
		}
	],
	
	// Queue consumer configuration
	"queues": {
		"consumers": [
			{
				"queue": "analysis-queue",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 3,
				"dead_letter_queue": "analysis-dlq"
			}
		]
	},
	
	// KV for caching
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "1ab4b592909d4fa1806273e6e47c020b",
			"preview_id": "1ab4b592909d4fa1806273e6e47c020b"
		}
	],
	
	// Environment variables
	"vars": {
		"ENVIRONMENT": "production"
	}
	
	// Note: Set OPENAI_API_KEY as a secret:
	// wrangler secret put OPENAI_API_KEY --config wrangler-analysis.jsonc
}

