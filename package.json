{
	"name": "whisper-tutorial",
	"version": "1.0.0",
	"private": true,
	"description": "Production-ready multi-worker interview transcription and analysis system",
	"scripts": {
		"dev": "wrangler dev",
		"dev:analysis": "wrangler dev --config wrangler-analysis.jsonc --port 8788",
		"dev:free": "wrangler dev --config wrangler-free.jsonc",
		"deploy": "wrangler deploy",
		"deploy:analysis": "wrangler deploy --config wrangler-analysis.jsonc",
		"deploy:all": "npm run deploy && npm run deploy:analysis",
		"deploy:free": "wrangler deploy --config wrangler-free.jsonc",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"setup": "./scripts/setup-cloudflare.sh",
		"migrate": "wrangler d1 execute whisper-db --file=migrations/0001_initial_schema.sql",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.8.19",
		"typescript": "^5.5.2",
		"vitest": "~3.2.0",
		"wrangler": "^4.54.0"
	}
}
